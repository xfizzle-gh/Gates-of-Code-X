{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gates-of-codex.invalid/schemas/opengs-gate2-config-v1.json",
  "title": "Gates of CodeX OpenGS Gate 2 geometry adapter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "map_id",
    "id_prefix",
    "minimum_shared_edge_pixels",
    "authored_boundary_pairs",
    "suppressed_segments"
  ],
  "properties": {
    "schema": {"const": "gates-of-codex.opengs-gate2-config"},
    "schema_version": {"type": "integer", "const": 1},
    "map_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "id_prefix": {"const": "og2_"},
    "minimum_shared_edge_pixels": {"type": "integer", "minimum": 1},
    "authored_boundary_pairs": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "suppressed_segments": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0},
        "minItems": 4,
        "maxItems": 4
      }
    }
  }
}
