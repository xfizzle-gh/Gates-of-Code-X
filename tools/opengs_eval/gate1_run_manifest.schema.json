{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gates-of-codex.invalid/schemas/opengs-run-manifest-v1.json",
  "title": "Gates of CodeX OpenGS deterministic run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generator_version",
    "generator_identity",
    "upstream_repository",
    "upstream_commit",
    "recipe",
    "inputs",
    "derived_seeds",
    "counts",
    "dimensions",
    "outputs",
    "determinism",
    "environment",
    "manifest_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "gates-of-codex.opengs-run-manifest"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generator_version": {
      "type": "integer",
      "const": 3
    },
    "generator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_files",
        "source_tree_sha256"
      ],
      "properties": {
        "source_files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate1_common.py",
            "gate1_regions.py",
            "gate1_pipeline.py",
            "gate1_generator.py"
          ],
          "properties": {
            "gate1_common.py": {
              "$ref": "#/$defs/sha256"
            },
            "gate1_regions.py": {
              "$ref": "#/$defs/sha256"
            },
            "gate1_pipeline.py": {
              "$ref": "#/$defs/sha256"
            },
            "gate1_generator.py": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "upstream_repository": {
      "const": "Thomas-Holtvedt/opengs-maptool"
    },
    "upstream_commit": {
      "const": "06e7ec8517bd45872cf44d77cb8784e5ffca49bb"
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "root_seed",
        "canonical_sha256"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "root_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "land",
        "boundary",
        "density",
        "terrain"
      ],
      "properties": {
        "land": {
          "$ref": "#/$defs/input"
        },
        "boundary": {
          "$ref": "#/$defs/input"
        },
        "density": {
          "$ref": "#/$defs/input"
        },
        "terrain": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/input"
            }
          ]
        }
      }
    },
    "derived_seeds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "actual"
      ],
      "properties": {
        "requested": {
          "$ref": "#/$defs/requested_counts"
        },
        "actual": {
          "$ref": "#/$defs/actual_counts"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "territories.png",
        "provinces.png",
        "territories.json",
        "provinces.json"
      ],
      "properties": {
        "territories.png": {
          "$ref": "#/$defs/sha256"
        },
        "provinces.png": {
          "$ref": "#/$defs/sha256"
        },
        "territories.json": {
          "$ref": "#/$defs/sha256"
        },
        "provinces.json": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implicit_randomness",
        "json_canonical",
        "png_metadata",
        "stable_color_assignment",
        "stable_iteration_order",
        "canonical_recipe_identity",
        "transactional_publish"
      ],
      "properties": {
        "implicit_randomness": {
          "const": false
        },
        "json_canonical": {
          "const": true
        },
        "png_metadata": {
          "const": false
        },
        "stable_color_assignment": {
          "const": true
        },
        "stable_iteration_order": {
          "const": true
        },
        "canonical_recipe_identity": {
          "const": true
        },
        "transactional_publish": {
          "const": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "numpy",
        "pillow",
        "scipy"
      ],
      "properties": {
        "python": {
          "const": "3.11.9"
        },
        "numpy": {
          "const": "2.3.5"
        },
        "pillow": {
          "const": "12.0.0"
        },
        "scipy": {
          "const": "1.16.3"
        }
      }
    },
    "manifest_payload_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requested_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "land_territories",
        "ocean_territories",
        "land_provinces",
        "ocean_provinces"
      ],
      "properties": {
        "land_territories": {
          "type": "integer",
          "minimum": 1
        },
        "ocean_territories": {
          "type": "integer",
          "minimum": 0
        },
        "land_provinces": {
          "type": "integer",
          "minimum": 1
        },
        "ocean_provinces": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "actual_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "territories",
        "land_territories",
        "ocean_territories",
        "provinces",
        "land_provinces",
        "ocean_provinces",
        "lake_provinces"
      ],
      "properties": {
        "territories": {
          "type": "integer",
          "minimum": 0
        },
        "land_territories": {
          "type": "integer",
          "minimum": 0
        },
        "ocean_territories": {
          "type": "integer",
          "minimum": 0
        },
        "provinces": {
          "type": "integer",
          "minimum": 0
        },
        "land_provinces": {
          "type": "integer",
          "minimum": 0
        },
        "ocean_provinces": {
          "type": "integer",
          "minimum": 0
        },
        "lake_provinces": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
